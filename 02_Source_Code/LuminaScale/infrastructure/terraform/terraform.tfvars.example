aws_region       = "ap-southeast-2"
processor_image  = "123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/luminascale-processor:latest"
mongo_url        = "mongodb+srv://USER:PASSWORD@HOST/luminascale"
postgres_url     = "postgresql://USER:PASSWORD@HOST:5432/luminascale?sslmode=require"
iot_data_endpoint = "https://example-ats.iot.ap-southeast-2.amazonaws.com"
min_tasks        = 1
max_tasks        = 10
backlog_per_task_target = 100

